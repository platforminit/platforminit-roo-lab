{
  "mcpServers": {
    "platforminit-roo-lab": {
      "command": "python3",
      "args": ["tools/platforminit_mcp/server.py"],
      "alwaysAllow": [
        "health",
        "get_delivery_context",
        "get_active_task",
        "get_changed_scope"
      ],
      "disabled": false,
      "timeout": 1200,
      "watchPaths": [
        "tools/platforminit_mcp/*.py",
        "tasks/tracker.json"
      ]
    }
  }
}
